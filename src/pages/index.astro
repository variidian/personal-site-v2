---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---
<Layout>
<div class="[&>img]:absolute [&>img]:inset-0 [&>img]:w-full">
	<img src="/public/art/wip section.webp" loading="lazy">
	<img src="/public/art/variidian section.webp" loading="lazy">
	<img src="/public/art/programmer section.webp" loading="lazy">
	<img src="/public/art/artist section.webp" loading="eager" fetchpriority="high">
	<img src="/public/art/who ru lf section.webp" loading="eager" fetchpriority="high">
	<img src="/public/art/hero astronaut.webp" loading="eager" fetchpriority="high">
	<img src="/public/art/cloudse.webp" loading="lazy">
	<img src="/public/art/clouds.webp" loading="lazy">
	<img src="/public/art/cloud1.webp" loading="lazy">
	<img src="/public/art/cloud.webp" loading="lazy">
	<img src="/public/art/outline - wip.webp" class="hidden" loading="lazy">
	<img src="/public/art/outline - variidian.webp" class="hidden" loading="lazy">
	<img src="/public/art/outline - programmer.webp" class="hidden" loading="lazy"> 
	<img src="/public/art/outline - artist.webp" class="hidden" loading="lazy">
